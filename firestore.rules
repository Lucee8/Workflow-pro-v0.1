rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection testing endpoint
    match /test/{testId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customer Profiles
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Production Status Logs
    match /statusLogs/{logId} {
      allow read, write: if true;
    }

    // Raw Materials & Timber Inventory
    match /materials/{materialId} {
      allow read, write: if true;
    }

    // Financial Payment Ledgers
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // MRP Hardware Master Catalog
    match /mrp_hardware/{itemId} {
      allow read, write: if true;
    }

    // MRP Wood & Board Master Catalog
    match /mrp_wood/{itemId} {
      allow read, write: if true;
    }

    // MRP Stock Consumption Logs
    match /mrp_consumption_logs/{logId} {
      allow read, write: if true;
    }

    // MRP Project Bill of Materials (BOM)
    match /mrp_project_boms/{projectId} {
      allow read, write: if true;
    }

    // CRM Customer Records
    match /crmCustomers/{customerId} {
      allow read, write: if true;
    }

    // CRM Price Quotations
    match /crmQuotations/{quotationId} {
      allow read, write: if true;
    }

    // CRM Lead Follow-up Schedules
    match /crmFollowUps/{followUpId} {
      allow read, write: if true;
    }

    // CRM Customer Payments & Advance Trackers
    match /crmPayments/{paymentId} {
      allow read, write: if true;
    }

    // CRM Interaction Notes
    match /crmNotes/{noteId} {
      allow read, write: if true;
    }

    // CRM Customer Attachments & Design Blueprints
    match /crmAttachments/{attachmentId} {
      allow read, write: if true;
    }

    // CRM Customer Action Timeline Events
    match /crmTimelineEvents/{eventId} {
      allow read, write: if true;
    }

    // Wood Requisition Tickets
    match /woodRequests/{requestId} {
      allow read, write: if true;
    }

    // Fallback catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
