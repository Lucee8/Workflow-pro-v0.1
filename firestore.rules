rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Production ERP Collections
    match /users/{userId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /statusLogs/{logId} {
      allow read, write: if true;
    }
    match /materials/{materialId} {
      allow read, write: if true;
    }
    match /payments/{paymentId} {
      allow read, write: if true;
    }
    match /crmCustomers/{customerId} {
      allow read, write: if true;
    }
    match /crmQuotations/{quotationId} {
      allow read, write: if true;
    }
    match /crmFollowUps/{followUpId} {
      allow read, write: if true;
    }
    match /crmPayments/{paymentId} {
      allow read, write: if true;
    }
    match /crmNotes/{noteId} {
      allow read, write: if true;
    }
    match /crmAttachments/{attachmentId} {
      allow read, write: if true;
    }
    match /crmTimelineEvents/{eventId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
    match /cncJobs/{jobId} {
      allow read, write: if true;
    }
    match /cncTools/{toolId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}



