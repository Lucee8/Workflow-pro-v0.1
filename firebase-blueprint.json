        "tool_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "run_time_minutes": { "type": "number" },
        "design_time_minutes": { "type": "number" },
        "design_time_value": { "type": "number" },
        "design_time_unit": { "type": "string" },
        "completion_time_minutes": { "type": "number" },
        "completion_time_value": { "type": "number" },
        "completion_time_unit": { "type": "string" },
        "start_time": { "type": "string", "description": "24-hour machine start time HH:MM" },
        "stop_time": { "type": "string", "description": "24-hour machine stop time HH:MM" },
        "machine_running_time": { "type": "string", "description": "Calculated total running duration HH:MM" },
        "is_overnight": { "type": "boolean", "description": "Indicates stop time crosses midnight" },
        "time_sessions": {
          "type": "array",
          "description": "Structured list of independent machine running time sessions for this job",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "start_time": { "type": "string" },
              "stop_time": { "type": "string" },
              "running_time": { "type": "string" },
              "duration_minutes": { "type": "number" },
              "is_overnight": { "type": "boolean" }
            }
          }
        },
        "operator_id": { "type": "string", "description": "Assigned CNC Operator User ID" },
        "operator_name": { "type": "string" },
        "amount": { "type": "number", "description": "CNC Workshop job revenue or rate" },
        "status": { "type": "string", "enum": ["Pending", "Queued", "In Progress", "Completed", "Rework"] },
        "notes": { "type": "string" },
        "design_file": { "type": "string" },
        "fileName": { "type": "string", "description": "Original file name of the CNC program file (.dxf / .nc)" },
        "fileUrl": { "type": "string", "description": "Firebase Storage direct download URL of the uploaded program file" },
        "storagePath": { "type": "string", "description": "Firebase Storage path in format: cnc-programs/{jobId}/{timestamp}_{fileName}" },
        "fileSize": { "type": "number", "description": "Size of the uploaded program file in bytes" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "design_file_url": { "type": "string", "description": "Firebase Storage download URL of the uploaded .dxf or .nc program file" },
        "design_file_name": { "type": "string", "description": "Original file name of the CNC program file" },
        "design_file_size": { "type": "number", "description": "Size of the uploaded program file in bytes" },
        "design_file_uploaded_at": { "type": "string", "format": "date-time" },
        "program_files_count": { "type": "number", "description": "Total attached program files count" },
        "image_url": { "type": "string" },
        "completed_at": { "type": "string" },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "job_date", "product_name", "job_type", "status", "created_at"]
    },
