    },
    "cncJob": {
      "title": "CNC Workshop Job",
      "description": "Daily CNC carving, cutting, grooving, or relief job record linked to production orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "order_id": { "type": "string", "description": "Foreign key to original production order" },
        "article_no": { "type": "string", "description": "Original order article number" },
        "customer_name": { "type": "string" },
        "jobName": { "type": "string", "description": "Dedicated job name entered for the CNC workshop task" },
        "job_number": { "type": "string", "description": "Sequential CNC job identifier" },
        "job_date": { "type": "string", "format": "date" },
        "product_name": { "type": "string" },
        "material": { "type": "string", "description": "Wood or panel material type" },
        "dimensions": { "type": "string" },
        "job_type": { "type": "string", "enum": ["Cutting", "Carving", "Turning", "Pillar", "Jali Cutting", "3D Relief", "Grooving", "Engraving", "Profile Cutting", "Moulding", "Surfacing", "Other"] },
